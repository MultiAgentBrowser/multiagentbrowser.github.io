{
  "name": "privacy-browser",
  "version": "1.0.0",
  "description": "Production-quality, privacy-focused desktop web browser for macOS and Windows",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite build --mode development && electron .",
    "build:ui": "vite build",
    "build:main": "tsc -p tsconfig.node.json",
    "build": "npm run build:ui && npm run build:main",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:mac": "npm run build && electron-builder --mac",
    "pack:win": "npm run build && electron-builder --win"
  },
  "keywords": [
    "privacy",
    "browser",
    "anti-tracking",
    "fingerprint-protection",
    "electron",
    "chromium"
  ],
  "author": "Privacy Browser Team",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  }
}
